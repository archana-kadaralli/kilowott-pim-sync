# Server-side WooCommerce credentials for LIVE sync (used by the sync proxy in
# Vite dev/preview and by `npm start`). These values never reach the browser.
# Copy this file to `.env.local`, fill in your store details, and restart the server.
# `.env.local` is gitignored — never commit real credentials.

# Required for live sync: your store's home URL.
# Remote stores must use https:// (http:// is accepted only for local-development
# hosts — localhost, *.local, *.test or private-network IPs — and only when
# WOO_ALLOW_LOCAL_HTTP=1 below).
WOO_STORE_URL=https://your-store.example

# Required: WooCommerce → Settings → Advanced → REST API → Add key (Read/Write).
WOO_CONSUMER_KEY=ck_your_consumer_key
WOO_CONSUMER_SECRET=cs_your_consumer_secret

# Optional local-development escape hatch: allow a plain-http:// store URL on a
# local-development host only (e.g. a throwaway local WordPress such as
# http://my-site.local). Never set this for a remote store.
# Note: WooCommerce 8+ only performs Basic auth over SSL, so even local stores
# should normally use their https:// URL — this flag only lifts the proxy's own
# URL check.
# WOO_ALLOW_LOCAL_HTTP=1

# Optional: port for the standalone server (`npm start`). Default 4173.
# PORT=4173
